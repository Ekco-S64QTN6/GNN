# test-harness output
.shot/

# editor
.vscode/

# python
__pycache__/
*.pyc

# the game data is NOT distributed with this project — see README > Legal
Master of Orion 1/
.gnn-server.pid
.gnn-server-*.pid
gnn-server.log
gnn-server.log.*
gnn-transcript.log
gnn-transcript.log.*

# local agent/workspace config
.agents/

# superseded notes — see docs/archive/README.md. Current truth is CLAUDE.md.
docs/archive/

# voice audition renders (regenerate with tools/voice_audition.py)
audition/

# local TTS virtualenv (see README > Local voice)
.venv/

# Raw art drops are large and are kept out; the *conditioned* plates under
# assets/generated/ are what the engine loads and are a few kilobytes each,
# so they are tracked — the app is meant to run from a clone alone.
assets/generated/_inbox/

# one-off bug capture, large; the fix and its measurements are in CLAUDE.md
docs/*.webm
# scene-review render output — regenerated locally with
# tools/scene_review.html; the README stays, the renders do not.
docs/scene-review/*.png
docs/scene-review/*.webm
# ------------------------------------------------------------------
# Extracted assets — regenerable from the game archives.
#
# The repo tracks the extraction pipeline, not its output. Anyone with
# a GoG copy of MoO1 and MoO2 can rebuild everything under assets/
# except assets/generated/ by running the tools in tools/. See
# tools/PROJECT.md for the pipeline and the order to run it in.
#
# assets/generated/ is deliberately not listed here. Those plates are
# AI-generated art, not decoded game data, and total a few hundred KB.
# They stay tracked so a fresh clone can run the broadcast immediately.
# ------------------------------------------------------------------
assets/anchor_frame_*.png
assets/anchor_frames/
assets/audio/
assets/audio-manifest.json
assets/background_tv.png
assets/cutscenes/
assets/gfx-manifest.json
assets/globe_frame_*.png
assets/globe_frames/
assets/icons/
assets/moo-strings.json
assets/text/

# palette-compare diagnostic output — regenerable with tools/palette_compare.py
tools/palette_compare/
tools/palette_survey/
tools/palette_review/

# runtime news ledger — grows during a session, not source
gnn-news-ledger.json

# Trailer: recorded takes and the rendered video are rebuilt by
# trailer/record_takes.py and trailer/make_trailer.py.
trailer/build/
trailer/out/
# Trailer build artifacts
trailer/build/*
!trailer/build/.gitkeep

trailer/out/*
!trailer/out/.gitkeep